[Unit]
Description=Money Tracker Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/money-tracker-bot
EnvironmentFile=/opt/money-tracker-bot/.env
ExecStart=/opt/money-tracker-bot/venv/bin/python -m bot.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
