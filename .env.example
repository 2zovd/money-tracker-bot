# Required
TELEGRAM_TOKEN=123456:ABC-token-from-BotFather   # @BotFather -> /newbot
ANTHROPIC_API_KEY=sk-ant-...                      # console.anthropic.com

# Multi-user: each user connects their own sheet at runtime via /start (guided wizard).
DB_FILE=data/users.db                             # per-user store (user -> their sheet)
TEMPLATE_SHEET_URL=                               # public template users copy (share: anyone with link, viewer)
SHEET_ID=                                         # optional: seeds ALLOWED_USER_ID users on first run

# Optional
ANTHROPIC_MODEL=claude-haiku-4-5                  # cheap default; any Claude model works
GOOGLE_SA_FILE=service_account.json               # path to the service-account key
GOOGLE_SA_EMAIL=                                  # optional override; otherwise read from the key file
ALLOWED_USER_ID=your-telegram-user-id             # comma-separated allowlist; empty = anyone may connect
WORKSHEET=Journal                                 # expenses tab name (must match the tracker)
INCOME_WORKSHEET=Income log                        # income tab name (created on first use)

# Currency (defaults to euro)
CURRENCY_SYMBOL=€
CURRENCY_CODE=EUR
USD_RATE=0.92                                      # 1 USD -> base currency
GBP_RATE=1.16                                      # 1 GBP -> base currency
